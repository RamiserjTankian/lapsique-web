APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SITE=lapsique
APP_TIMEZONE=America/Cancun

# Booking test mode skips external payment only on localhost, 127.0.0.1 and *.test hosts.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailtrap
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_STATEMENT_DESCRIPTOR="LAPSIQUE"
MERCADOPAGO_CURRENCY=MXN
MERCADOPAGO_SANDBOX=false

# Meta — ver config/meta.php (pixel, CAPI, Marketing API, atribución)
META_PIXEL_ENABLED=false
META_PIXEL_ID=
META_PIXEL_AUTO_TRACK=true
META_PIXEL_TRACK_PAGEVIEW=true

# Marketing API (gastos de campañas en admin) + CAPI (conversiones server-side)
META_ADS_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0
META_CAPI_ENABLED=false
META_TEST_EVENT_CODE=
META_SYNC_DAYS_DEFAULT=30
META_REPORT_CACHE_MINUTES=30

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_CURRENCY=MXN
#STRIPE_WEBHOOK_SECRET_EXAMPLE=


MAILTRAP_SCHEME=null
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=api
MAILTRAP_PASSWORD=
MAILTRAP_API_TOKEN=
MAILTRAP_API_ENDPOINT=https://send.api.mailtrap.io/api/send
MAILTRAP_API_TIMEOUT=15
MAILTRAP_ACCOUNT_ID=
MAILTRAP_EVENTS_ENDPOINT=
MAILTRAP_EVENTS_PER_PAGE=100
MAILTRAP_EVENTS_MAX_PAGES=5
MAILTRAP_SEND_DELAY_MS=1000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Local path to source clips for: php artisan landing:videos-import (requires ffmpeg)
LANDING_VIDEOS_SOURCE=/Users/redasoft/Documents/PROYECTOS
# Local library: python3 scripts/collect_drive_media.py --copy
LANDING_MEDIA_LOCAL=/Users/redasoft/Documents/Lapsique-Media-Local
LANDING_DRIVE_LAPSIQUE_CONTENIDO="/Users/redasoft/Library/CloudStorage/GoogleDrive-ramiro@lapsique.media/My Drive/LAPSIQUE.MEDIA/2.- CONTENIDO"
LANDING_DRIVE_LAPSIQUE_PROYECTOS="/Users/redasoft/Library/CloudStorage/GoogleDrive-ramiro@lapsique.media/My Drive/LAPSIQUE.MEDIA/2.- CONTENIDO/1.- PROYECTOS"
LANDING_DRIVE_BLUEPOINT="/Users/redasoft/Library/CloudStorage/GoogleDrive-ramiro@bluepointrs.com/My Drive"

VITE_APP_NAME="${APP_NAME}"

TRASCENDENTAL_LEAD_NOTIFY_EMAIL=
TRASCENDENTAL_WHATSAPP=
